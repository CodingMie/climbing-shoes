# 本地开发（默认）：本地 SQLite 文件，无需任何配置。
# 数据库文件路径可用 DATABASE_PATH 覆盖，默认 data/app.db。
# DATABASE_PATH=data/app.db

# ---- 生产（Turso）----
# 设置以下两个变量后，应用与 db:migrate / db:seed 脚本会自动切换到 Turso 远程库。
# TURSO_DATABASE_URL=libsql://<database>.turso.io
# TURSO_AUTH_TOKEN=<access-token>

# ---- better-auth ----
# 生产环境必填（≥32 字符随机串），例如：openssl rand -hex 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://<your-domain>